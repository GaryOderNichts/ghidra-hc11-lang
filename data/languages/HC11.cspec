<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>  <!-- These tags need to be verified -->
     <absolute_max_alignment value="0" />
     <machine_alignment value="1" />
     <default_alignment value="1" />
     <pointer_size value="2" />
     <wchar_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <!-- <size_alignment_map>
			<entry size="1" alignment="1" />
			<entry size="2" alignment="1" />
			<entry size="4" alignment="1" />
			<entry size="8" alignment="1" />
		</size_alignment_map> -->
  </data_organization>

  <global>
    <!-- Don't consider IRAM containing soft registers global -->
    <range space="RAM" first="0x100" last="0xffff"/>
  </global>

  <!-- Assume there is no aliasing into soft registers -->
  <!-- <nohighptr> -->
    <!-- <range space="RAM" first="0x0" last="0xff"/> -->
  <!-- </nohighptr> -->

  <stackpointer register="SP" space="RAM" growth="negative"/>
  <!-- <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress> -->

  <!-- <spacebase name="FramePointer" register="SREGFRAME" space="RAM"/> -->

  <default_proto>
    <prototype name="__asmA" extrapop="2" stackshift="2" strategy="standard">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="D"/>
        </pentry>
        <pentry minsize="3" maxsize="4" extension="zero">
          <addr space="join" piece1="IX" piece2="D"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="3" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="D"/>
        </pentry>
        <pentry minsize="3" maxsize="4" extension="zero">
          <addr space="join" piece1="IX" piece2="D"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="SREGFRAME"/>
      </unaffected>
      <killedbycall>
        <register name="D"/>
        <register name="IX"/>
        <register name="IY"/>
      </killedbycall>
      <!-- <localrange>
        <range space="stack" first="0xff00" last="0xfffe"/>
      </localrange> -->
    </prototype>
  </default_proto>

  <!-- <deadcodedelay space="stack" delay="10"/> -->

</compiler_spec>
